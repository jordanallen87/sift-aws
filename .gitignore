.env
.env.local
.env.*.local
!.env.example

# Editor and OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker
.docker/

# Local runtime database (`.sift-data/sift.sqlite` locally, `/data` in deployment).
# Runtime state, not a fixture -- it was tracked, so every local run dirtied the tree.
.sift-data/

# Stray local capture files (screenshots dropped at the repo root).
/*.png
