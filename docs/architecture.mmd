%% Sift Architecture Diagram
%% ---------------------------------------------------------------------------
%% Canonical source. Do not hand-edit docs/architecture.png -- edit this file
%% and regenerate with `pnpm docs:diagram` (scripts/generate-diagram.ts calls
%% @mermaid-js/mermaid-cli to render this file to docs/architecture.png).
%% ---------------------------------------------------------------------------
%% This diagram is the "Required architecture diagram" evidence for
%% docs/submissions/agents-for-humans/requirements-checklist.md. It must
%% visually distinguish:
%%   1. ChatGPT / WebMCP browser interaction
%%   2. Railway web/API services and persistent SQLite storage
%%   3. Deterministic Sift evidence / readiness / budget / authority governance
%%   4. The compiled Decision Pack vs. the mutable case / run plan
%%   5. Strands AgentSkills, Graph/Swarm, interventions, Context Injector,
%%      GoalLoop, sessions, hooks
%%   6. Local vs. AgentCore execution targets -- SIFT_EXECUTION_TARGET is
%%      validated to exactly these two values (apps/agent/src/config.ts) but
%%      is NOT currently read anywhere to branch a request (grep confirms its
%%      only runtime use is one startup log line in server.ts); both HTTP
%%      surfaces below are simultaneously and unconditionally live on every
%%      deployment regardless of its value. The diagram draws them as two
%%      concurrently-mounted entry points into the same command layer, not
%%      as a live runtime switch.
%%   7. Sift-minted trace/correlation ids linking lifecycle-hook events to the
%%      Runtime Inspector, PLUS the real OpenTelemetry span path added
%%      2026-09-04 (apps/agent/src/runtime/otel-span-recorder.ts):
%%      installSiftTracing() registers a real NodeTracerProvider and calls
%%      the Strands SDK's own setupTracer({ provider }) at startup
%%      (apps/agent/src/server.ts), so the spans @strands-agents/sdk already
%%      emits are captured by SiftSpanRecorder (a real SpanProcessor) and
%%      persisted into runtime_events with real span_id/parent_span_id and a
%%      real ReadableSpan.duration-measured durationMs. A conditional OTLP
%%      exporter (BatchSpanProcessor(new OTLPTraceExporter())) additionally
%%      attaches when OTEL_EXPORTER_OTLP_ENDPOINT is set; unset, no exporter
%%      is created and nothing opens a socket. Still NOT implemented and
%%      deliberately absent from this diagram: setupMeter()/OTEL metrics, W3C
%%      traceparent propagation to AgentCore/CloudWatch, and any CloudWatch/
%%      AgentCore Observability correlation for the OTel path specifically --
%%      see docs/submissions/webmcp/claim-evidence-matrix.md rows E8/E9.
%%   8. The human-only approval boundary (styled distinctly, not just another
%%      box in the flow)
%%   9. Run/tool budget enforcement and steering (BudgetGuard, RetrySteering,
%%      EvidenceQualitySteering -- apps/agent/src/runtime/interventions.ts)
%%      live inside the Strands runtime adapter, NOT packages/core: they
%%      extend the Strands SDK's own InterventionHandler and import
%%      @strands-agents/sdk directly, so they are excluded from "pure
%%      functions: no model, no I/O." Moved out of CORE and folded into
%%      STRANDS's Interventions node on 2026-09-13 after this was verified
%%      against the actual imports (packages/core has no budget/steering
%%      module at all -- grep confirms it).
%% Also folds in the instrumentation pipeline from
%% docs/specs/debugging-and-observability.md (hooks/domain events ->
%% TelemetryNormalizer -> Redactor -> runtime_events -> Inspector/bundle).
%% ---------------------------------------------------------------------------
%% Subgraphs are declared in roughly the order data flows top to bottom so
%% the automatic layout keeps related pieces close together; edges that
%% loop back upstream (approval, telemetry sources) are the deliberate
%% exceptions and stay minimal by design.
%% ---------------------------------------------------------------------------

flowchart TD

  subgraph BROWSER["ChatGPT Right Pane (Browser)"]
    direction TB
    CHATGPT["ChatGPT conversation frame<br/>hosts the 390-480px right pane"]
    WEBMCP["WebMCP tool calls<br/>functions registered with ChatGPT"]
    UI["React/Vite UI controls<br/>renders canonical CaseState"]
    CMDCLIENT["Shared SiftCommands client<br/>one command implementation for<br/>UI controls and WebMCP callbacks"]
    CHATGPT --> UI
    CHATGPT --> WEBMCP
    UI --> CMDCLIENT
    WEBMCP --> CMDCLIENT
  end

  subgraph RAILWAY["Railway Web/API Gateway (Express, one service)"]
    direction TB
    HTTP["HTTP + SSE routes<br/>/api/cases/*, /api/cases/:id/events"]
    PINGINV["/ping, /invocations<br/>AgentCore-compatible contract"]
    CMDHANDLER["Command handler<br/>optimistic concurrency + idempotency keys"]
    HTTP --> CMDHANDLER
    PINGINV --> CMDHANDLER
  end

  subgraph CORE["Deterministic Sift Core (pure functions: no model, no I/O)"]
    direction TB
    ROUTE["routePack / instantiateCase"]
    OBLIG["deriveObligations /<br/>selectNextObligation"]
    EVID["Evidence validity<br/>and source links"]
    READY["evaluateReadiness"]
    AUTHGATE{{"reviewProposal()<br/>rejects any actor != human"}}
    ROUTE --> OBLIG --> EVID --> READY
  end

  subgraph PACKCASE["Compiled Decision Pack vs. Mutable Case / Run Plan"]
    direction TB
    PACK[["Compiled Decision Pack<br/>pinned id + version + compiledHash<br/>IMMUTABLE"]]
    CASEPLAN["Case-specific run plan<br/>mutable CaseState + custom.* extensions"]
    PACK -->|"adapter compiles a bounded<br/>run plan; never rewrites the pack"| CASEPLAN
  end

  subgraph TARGETS["Execution Targets (SIFT_EXECUTION_TARGET;<br/>both surfaces always live, not env-selected)"]
    direction TB
    LOCALEXEC["local: in-process Strands adapter<br/>reached via /api/cases/*"]
    AGENTCOREEXEC["agentcore: AgentCore-compatible contract<br/>port 8080, /ping + /invocations<br/>(built and live; not yet deployed to Bedrock)"]
  end

  subgraph STRANDS["Strands TypeScript Runtime Adapter"]
    direction TB
    SKILLS["AgentSkills<br/>progressive activation"]
    GRAPHSWARM["Strands Graph (Car Pack) /<br/>bounded Strands Swarm<br/>(Energy Pack, Bid Comparison Pack)"]
    CTXINJ["Context Injector<br/>current case projection, evidence, budgets"]
    GOALLOOP["GoalLoop<br/>recommendation validator, maxAttempts: 2"]
    INTERVENE{{"Interventions: ScopeAuthorization,<br/>ConsequenceGuard, BudgetGuard,<br/>RetrySteering, EvidenceQualitySteering<br/>(Guide / Confirm / Deny)"}}
    SESS[("Sessions and snapshots<br/>LocalFileStorage")]
    HOOKS["Lifecycle hooks"]
    BIDREADER["Bid document reader<br/>real Strands Agent on a real BedrockModel<br/>SIFT_BID_DOCUMENT_READER_ENABLED, opt-in"]
    CTXINJ --> SKILLS --> GRAPHSWARM
    GRAPHSWARM --> GOALLOOP
    GRAPHSWARM -.->|"no-progress -> Guide"| INTERVENE
    GOALLOOP -.->|"exhausted -> feedback"| INTERVENE
    GRAPHSWARM --> HOOKS
    SESS -.-> GRAPHSWARM
  end

  subgraph HUMAN["HUMAN-ONLY APPROVAL BOUNDARY"]
    direction TB
    HUMANACTOR(("Human user"))
    APPROVE{{"Approve / Confirm<br/>the consequential decision"}}
    HUMANACTOR --> APPROVE
  end

  subgraph PERSIST["SQLite Persistence (better-sqlite3 + Drizzle, WAL)"]
    direction TB
    CASES[("cases<br/>latest snapshot + pinned pack ref")]
    EVENTS[("case_events<br/>append-only canonical")]
    ACTIVITY[("activity_events<br/>sanitized public stream")]
    RUNS[("runs")]
    RUNTIME[("runtime_events<br/>sanitized telemetry")]
  end

  subgraph OBS["Observability Pipeline"]
    direction TB
    NORM["TelemetryNormalizer<br/>Sift-minted traceId per run"]
    REDACT["Redactor<br/>strips secrets, headers, raw reasoning"]
    OTELSPANS["Strands SDK spans<br/>(graph/swarm/agent/model/tool)<br/>already emitted, previously discarded"]
    SPANREC["SiftSpanRecorder<br/>real SpanProcessor, NodeTracerProvider<br/>span_id / parent_span_id / durationMs"]
    OTLP["OTLPTraceExporter (conditional)<br/>only when OTEL_EXPORTER_OTLP_ENDPOINT is set"]
    INSPECTOR["Runtime Inspector SSE<br/>SIFT_DEBUG_ENABLED"]
    BUNDLE["Sanitized JSON run bundle export"]
    NORM --> REDACT --> RUNTIME
    OTELSPANS --> SPANREC --> RUNTIME
    SPANREC -.->|"OTEL_EXPORTER_OTLP_ENDPOINT set"| OTLP
    RUNTIME --> INSPECTOR
    RUNTIME --> BUNDLE
  end

  subgraph AWS["AWS (credential-gated)"]
    direction TB
    BEDROCK["Amazon Bedrock<br/>Amazon Nova Lite (amazon.nova-lite-v1:0)<br/>LIVE inference: reads a bid document,<br/>proposes values, never marks them verified"]
    CW["CloudWatch /<br/>AgentCore Observability"]
  end

  %% Command and event flow (architecture.md "Command and event flow")
  CMDCLIENT -->|"validated command<br/>+ idempotency key"| HTTP
  CMDHANDLER -->|"routes / instantiates case"| ROUTE
  PACK -->|"registry lookup"| ROUTE
  OBLIG -->|"selected obligation +<br/>read-only case snapshot"| CASEPLAN
  CASEPLAN --> CTXINJ

  CMDHANDLER -->|"/api/cases/* path"| LOCALEXEC
  CMDHANDLER -->|"/invocations path"| AGENTCOREEXEC
  LOCALEXEC --> STRANDS
  AGENTCOREEXEC --> STRANDS
  AGENTCOREEXEC -.->|"trace/session/request IDs<br/>(only once actually deployed)"| CW

  HTTP -->|"PDF text extracted in the browser,<br/>posted as plain text"| BIDREADER
  BIDREADER -->|"real model call"| BEDROCK
  BIDREADER -->|"attributes as origin: agent_proposed,<br/>never verified"| CASEPLAN
  INTERVENE -->|"candidate evidence /<br/>candidate recommendation only"| EVID
  READY -->|"recommendation<br/>(a proposal, not a decision)"| HUMAN
  INTERVENE -->|"Confirm required"| HUMAN
  HUMANACTOR -->|"reviewProposal(actor: 'human')"| AUTHGATE
  AUTHGATE -->|"approved decision"| CASEPLAN

  CMDHANDLER --> CASES
  CMDHANDLER --> EVENTS
  HOOKS --> ACTIVITY
  STRANDS --> RUNS

  HOOKS -.->|"Strands tool/model<br/>hook events"| NORM
  GRAPHSWARM -.->|"Graph/Swarm node +<br/>handoff hook events"| NORM
  CMDHANDLER -.->|"Sift domain events"| NORM
  HTTP -.->|"HTTP/SSE/storage events"| NORM
  INTERVENE -.->|"intervention/plugin events"| NORM
  SESS -.->|"session/snapshot events"| NORM
  GRAPHSWARM -.->|"real OTel spans<br/>(graph/swarm/agent/model/tool)"| OTELSPANS

  classDef browser fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e;
  classDef railway fill:#ede9fe,stroke:#6d28d9,color:#3b0764;
  classDef core fill:#dcfce7,stroke:#15803d,color:#14532d;
  classDef packcase fill:#fef9c3,stroke:#a16207,color:#713f12;
  classDef strands fill:#ffe4e6,stroke:#be123c,color:#881337;
  classDef targets fill:#f1f5f9,stroke:#334155,color:#0f172a;
  classDef persist fill:#e0e7ff,stroke:#4338ca,color:#312e81;
  classDef obs fill:#fae8ff,stroke:#a21caf,color:#701a75;
  classDef aws fill:#fff7ed,stroke:#c2410c,color:#7c2d12;
  classDef human fill:#fef3c7,stroke:#b45309,stroke-width:4px,color:#78350f;
  classDef authGate fill:#fee2e2,stroke:#b91c1c,stroke-width:3px,color:#7f1d1d;

  class BROWSER browser
  class RAILWAY railway
  class CORE core
  class PACKCASE packcase
  class STRANDS strands
  class TARGETS targets
  class PERSIST persist
  class OBS obs
  class AWS aws
  class HUMAN human
  class AUTHGATE,APPROVE authGate
