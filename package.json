{
  "name": "sift",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Sift: a real-time, source-linked decision workspace. Dual-hackathon monorepo root.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && tsx scripts/check-source.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pack": "vitest run packages/packs/src apps/agent/src/authoring apps/agent/src/fixtures/apartment-hunt-extension.test.ts packages/core/src/extensions.test.ts",
    "test:integration": "vitest run apps/agent/src/routes apps/agent/src/store apps/agent/src/db apps/agent/src/app.test.ts apps/agent/src/runtime/strands-adapter.test.ts apps/agent/src/runtime/event-normalizer.test.ts apps/agent/src/runtime/interventions.test.ts apps/agent/src/runtime/plugins.test.ts apps/agent/src/runtime/model-provider.test.ts apps/agent/src/runtime/session-adapter.test.ts apps/agent/src/runtime/car-purchase-engine.test.ts apps/agent/src/runtime/home-energy-engine.test.ts",
    "test:contract": "vitest run apps/web/src/model-context/webmcp-contract.test.ts apps/agent/src/routes/agentcore.test.ts",
    "test:scenario": "vitest run --project tests",
    "test:persona": "tsx scripts/test-persona.ts",
    "test:e2e": "pnpm --filter @sift/web build && playwright test",
    "test:observability": "tsx scripts/stage-not-implemented.ts test:observability",
    "test:mutation": "stryker run",
    "test:live": "tsx scripts/stage-not-implemented.ts test:live",
    "test:deployed": "tsx scripts/test-deployed.ts",
    "test:host": "tsx scripts/test-host.ts",
    "test:journey": "tsx scripts/test-journey.ts",
    "webmcp:bridge": "tsx scripts/webmcp-bridge.ts",
    "test:submission": "tsx scripts/test-submission.ts",
    "check:source": "tsx scripts/check-source.ts",
    "docs:diagram": "tsx scripts/generate-diagram.ts",
    "sift": "tsx scripts/sift-cli.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "contact:sheet": "tsx scripts/contact-sheet.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
